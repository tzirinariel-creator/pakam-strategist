# ===================================
# Pakam Strategist — Environment Variables
# ===================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git!

# -----------------------------------
# Supabase
# -----------------------------------
# Get these from: https://supabase.com/dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# -----------------------------------
# Database (Supabase PostgreSQL)
# -----------------------------------
# Get from: Supabase Dashboard → Settings → Database → Connection String
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# -----------------------------------
# Encryption Key (for API keys & tokens)
# -----------------------------------
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your_64_char_hex_string_here

# -----------------------------------
# Google OAuth (for Calendar & Drive)
# -----------------------------------
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# -----------------------------------
# AI assistant — the shared FREE Gemini key (the King)
# -----------------------------------
# Get from: https://aistudio.google.com/apikey  (keep BILLING OFF on that Google
# project — that is the only hard guarantee the shared key can never be charged).
# Without this, every student WITHOUT their own BYOK key gets HTTP 412
# "No API key configured" and the assistant is dead for them.
GEMINI_SHARED_KEY=
# Optional override for the PRIMARY model, so a Google model retirement can be
# hot-fixed from the Vercel dashboard with no deploy. Must be a CURRENTLY FREE
# model (see memory: gemini-model-must-stay-current). Defaults to
# gemini-2.5-flash-lite, falling back to gemini-2.5-flash.
GEMINI_MODEL=

# -----------------------------------
# ScrapingBee (Course Scraping - Optional)
# -----------------------------------
# Get from: https://www.scrapingbee.com/
SCRAPINGBEE_API_KEY=your_scrapingbee_api_key
# Set to "true" to use premium proxies
SCRAPINGBEE_PREMIUM=false

# -----------------------------------
# Cron / Webhooks
# -----------------------------------
# Secret for authenticating cron job requests
CRON_SECRET=your_cron_secret

# Secret for one-time setup endpoints
SETUP_SECRET=your_setup_secret

# -----------------------------------
# Demo & Test Users (Optional)
# -----------------------------------
NEXT_PUBLIC_DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=your_demo_password
NEXT_PUBLIC_TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=your_test_password
# Show demo login button on auth page
NEXT_PUBLIC_SHOW_DEMO=false

# -----------------------------------
# Application
# -----------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# -----------------------------------
# Deploy notifications (Optional — local tooling, scripts/notify-deploy.ts)
# -----------------------------------
# Free key from https://resend.com. Only used by the manual notify-deploy script;
# the app itself never reads these.
RESEND_API_KEY=
NOTIFY_TO=
NOTIFY_FROM=
